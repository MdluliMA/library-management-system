              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Delete book (LIBRARIAN only)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        },
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
